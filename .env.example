APP_ENV=development
DEMO_MODE=false
DATABASE_URL=sqlite:///./incident_command.db
INCIDENT_DB_PATH=data/incidents.db
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=

# Zero-cost AI strategy. In `auto`, Gemini is PRIMARY when a key is configured,
# then local Ollama/Qwen is used as fallback, then deterministic evidence rules.
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=8
AUTOFIX_LLM_TIMEOUT_SECONDS=45

# Primary AI: Gemini Developer API free tier when GEMINI_API_KEY is configured.
# Keep the key only in your local .env; .env is gitignored and must never be committed.
# Flash-Lite is the fast default. You can change the model if your account/quota supports another Gemini model.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# Secondary AI fallback: fully local Ollama/Qwen. No API key and no per-call charge.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Legacy/custom OpenAI-compatible provider fields. Not required for the prototype.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Local AutoFix is restricted to registered targets below this root. Empty = this repository root.
AUTOFIX_WORKSPACE_ROOT=

GITHUB_REPOSITORY=omghotekar01-dotcom/KURUKSHETRA-2.O
GITHUB_ALLOWED_REPOSITORIES=omghotekar01-dotcom/KURUKSHETRA-2.O
GITHUB_CONTEXT_MAX_COMMITS=5
GITHUB_CONTEXT_MAX_ISSUES=5
GITHUB_TOKEN=
ALLOW_GH_CLI_AUTH=true
# Optional real-team routing, e.g. Authentication=identity-platform,Database=data-platform
TRIAGE_OWNER_MAP=
# Refuse exact patch proposals below this incident/evidence correlation score.
PATCH_PROPOSAL_MIN_CORRELATION=0.18
